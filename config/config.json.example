{
    "_comment": "Configuration template for Artwork Uploader for Plex",
    "_instructions": "1. Copy this file to 'config.json' 2. Replace the placeholder values below 3. Restart the application",

    "base_url": "http://your-plex-server:32400",
    "_base_url_help": "The URL to your Plex server. Use http://localhost:32400 for local servers or http://IP:32400 for remote servers",

    "token": "YOUR_PLEX_TOKEN_HERE",
    "_token_help": "Your Plex authentication token. Find it at: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/",

    "bulk_txt": "bulk_import.txt",
    "_bulk_txt_help": "Default filename for bulk import operations",

    "tv_library": ["TV Shows"],
    "_tv_library_help": "List of TV library names in Plex. Can be a single string or array of strings",

    "movie_library": ["Movies"],
    "_movie_library_help": "List of movie library names in Plex. Can be a single string or array of strings",

    "mediux_filters": [
        "title_card",
        "background",
        "season_cover",
        "show_cover",
        "movie_poster",
        "collection_poster",
        "square_art"
    ],
    "_mediux_filters_help": "Default artwork types to process from MediUX. Remove types you don't want to upload",

    "tpdb_filters": [
        "season_cover",
        "show_cover",
        "movie_poster",
        "collection_poster"
    ],
    "_tpdb_filters_help": "Default artwork types to process from ThePosterDB. Remove types you don't want to upload",

    "kometa_base": "",
    "_kometa_base_help": "Path to your Kometa asset base folder",

    "temp_dir": "",
    "_temp_dir_help": "Path to a temporary directory to use instead of the Kometa asset directory, for testing purposes",

    "save_to_kometa": false,
    "_save_to_kometa_help": "Saves artwork to Kometa asset directory instead of applying it to Plex directly",

    "stage_assets": false,
    "_stage_assets": "Saves artwork for seasons and episodes not yet in Plex (except season specials)",

    "track_artwork_ids": true,
    "_track_artwork_ids_help": "Use Plex labels to track uploaded artwork and prevent duplicate uploads",

    "auto_manage_bulk_files": true,
    "_auto_manage_bulk_files_help": "Automatically organize bulk import files after processing",

    "reset_overlay": true,
    "_reset_overlay_help": "Remove Kometa's 'Overlay' label when uploading new artwork",

    "skip_locked_artwork": false,
    "_skip_locked_artwork_help": "Skip artwork whose target field is locked in Plex (already set), unless --force is used",

    "schedules": [],
    "_schedules_help": "Scheduled bulk import jobs. Configure through the web UI",

    "apprise_urls": [],
    "_apprise_urls": "Comma-separated list of Apprise notification URLs",

    "auth_mode": "none",
    "_auth_mode_help": "Authentication for the web UI: 'none', 'password' or 'oidc'",

    "oidc_issuer": "",
    "_oidc_issuer_help": "OIDC provider issuer URL, e.g. https://auth.example.com/application/o/artwork-uploader/ (env OIDC_ISSUER wins)",

    "oidc_client_id": "",
    "_oidc_client_id_help": "OIDC client ID (env OIDC_CLIENT_ID wins)",

    "oidc_client_secret": "",
    "_oidc_client_secret_help": "OIDC client secret - prefer the OIDC_CLIENT_SECRET environment variable, which takes precedence",

    "oidc_scopes": "openid profile email groups",
    "_oidc_scopes_help": "Space separated scopes to request",

    "oidc_groups_claim": "groups",
    "_oidc_groups_claim_help": "Claim holding the user's groups; dotted paths like resource_access.app.roles are supported",

    "oidc_allowed_groups": [],
    "_oidc_allowed_groups_help": "Groups allowed to sign in. Empty means any user the provider lets through",

    "oidc_allow_password_fallback": true,
    "_oidc_allow_password_fallback_help": "Keep local password sign-in at /login?local=1 as a break-glass route",

    "oidc_provider_name": "SSO",
    "_oidc_provider_name_help": "Label shown on the sign-in button",

    "external_url": "",
    "_external_url_help": "Public base URL of this app, used to build the OIDC redirect URI",

    "trusted_proxy_count": 1,
    "_trusted_proxy_count_help": "Number of reverse proxies whose X-Forwarded-* headers are trusted; 0 when exposed directly",

    "session_cookie_secure": "auto",
    "_session_cookie_secure_help": "'auto' sets the Secure cookie flag when external_url is HTTPS; 'always' or 'never' to override",

    "cors_allowed_origins": [],
    "_cors_allowed_origins_help": "Origins allowed to call the HTTP/Socket.IO APIs. Empty means same-origin only"
}